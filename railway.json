{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 5,
    "startCommand": "nginx -g \"daemon off;\""
  },
  "healthcheck": {
    "startPeriod": "10s",
    "interval": "30s",
    "timeout": "5s",
    "retries": 3,
    "httpPath": "/index.html",
    "httpPort": 80
  }
}
