# Dockerfile optimized for Railway deployment
# Flutter web application with multi-stage build for minimal final image size

# ============ BUILD STAGE ============
FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_VERSION=3.38.8
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$PATH"
ENV PUB_CACHE=/home/flutter/.pub-cache

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    unzip \
    xz-utils \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for Flutter
RUN useradd -m -d /home/flutter -s /bin/bash flutter && \
    mkdir -p /home/flutter/.pub-cache && \
    chown -R flutter:flutter /home/flutter

# Clone Flutter SDK with specific version
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git ${FLUTTER_HOME} && \
    chown -R flutter:flutter ${FLUTTER_HOME}

# Switch to non-root user
USER flutter
WORKDIR /app

# Copy pubspec files for dependency caching layer
COPY --chown=flutter:flutter pubspec.yaml pubspec.lock ./

# Get Flutter dependencies (cached layer)
RUN flutter config --enable-web && \
    flutter pub get

# Copy entire project
COPY --chown=flutter:flutter . .

# Build web release (with optimization flags)
RUN flutter build web --release \
    --no-tree-shake-icons \
    --dart-define=FLUTTER_WEB_CANVASKIT_URL=https://cdn.jsdelivr.net/npm/canvaskit-wasm@latest/

# ============ RUNTIME STAGE ============
FROM nginx:1.27-alpine

# Install additional utilities for health checks (minimal footprint)
RUN apk add --no-cache curl

# Copy custom nginx configuration (must replace default to fix PID path)
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built Flutter web application from build stage
COPY --from=build /app/build/web /usr/share/nginx/html

# Use the existing nginx user (pre-installed in alpine)
# This avoids the "unknown user/group" error when trying to create www-data
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    mkdir -p /var/run/nginx && \
    chown -R nginx:nginx /var/run/nginx

USER nginx

# Expose port (Railway will expose via environment variable)
EXPOSE 80

# Health check for Railway platform
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/index.html || exit 1

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
